# Shell & Configuration
alias reload="source ~/.zshrc"
alias dotupdate="~/.dotfiles/update.sh"

# Directory Navigation
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."
alias .....="cd ../../../.."
alias ~="cd ~"
alias bd="cd -"

# File & Directory Listings (Colorized)
alias ls="ls --color=auto"
alias ll="ls -alF"
alias la="ls -A"
alias l="ls -CF"

# Safety & Convenience
alias cp="cp -i"
alias mv="mv -i"
alias rm="rm -i"
alias mkdir="mkdir -p"

# Utilities & System Info
alias c="clear"
alias h="history"
alias myip="curl -s https://icanhazip.com"
